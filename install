#!/usr/bin/env bash
# install — publish this working tree as the "released" edition.
#
# Scripts that announce a finished job find `teams-send` on PATH, which execs
# the DEPLOYED copy — never this directory. That is the whole point: editing
# send.js must not change what an unattended job posts to a colleague's chat
# five minutes later. Nothing reaches those callers until you run this.
#
# The copy is a real copy, not a symlink. A symlink would put the working tree
# back in the execution path, so a branch switch or a half-saved edit would
# reach them again.
set -euo pipefail

SRC_DIR="$(cd "$(dirname "$0")" && pwd)"
SRC="$SRC_DIR/send.js"
STATE_DIR="${TEAMS_SEND_HOME:-$HOME/.teams-send}"
DEPLOY_DIR="$STATE_DIR/deploy"
DEPLOY="$DEPLOY_DIR/send.js"
VERSION="$DEPLOY_DIR/VERSION.json"
BIN="$HOME/bin/teams-send"

say() { printf 'install: %s\n' "$1"; }
die() { printf 'install: %s\n' "$1" >&2; exit 1; }

[ -f "$SRC" ] || die "no send.js beside this script ($SRC)"

# ---------------------------------------------------------------- gates
# These are the only thing standing between an edit and an unattended send, so
# a failure here must stop the deploy rather than warn about it.

say "running tests…"
( cd "$SRC_DIR" && npm test >/dev/null 2>&1 ) || die "npm test FAILED — not deploying"

say "checking syntax…"
node --check "$SRC" || die "syntax error — not deploying"

# --check only proves the file parses. Removing a const while leaving a
# reference to it passes --check and dies at runtime. Actually executing a
# command is the cheapest way to catch it.
say "running send.js --help…"
node "$SRC" --help >/dev/null 2>&1 || die "send.js --help failed at runtime — not deploying"

# ---------------------------------------------------------------- deploy
mkdir -p "$DEPLOY_DIR"

# The deployed copy sits outside this project, so `require('playwright')` no
# longer finds ./node_modules by walking up. The wrapper offers this project's
# node_modules through NODE_PATH; note that Node consults NODE_PATH only AFTER
# the directories above the deploy dir, so a ~/node_modules/playwright wins.
# --help never loads playwright, so prove it resolves from where it will run.
say "checking playwright resolves from the deploy dir…"
PW="$(cd "$DEPLOY_DIR" && NODE_PATH="$SRC_DIR/node_modules" node -e \
  "const p=require.resolve('playwright/package.json');console.log(require(p).version+' at '+require('path').dirname(p))" 2>/dev/null)" \
  || die "playwright does not resolve from $DEPLOY_DIR — run npm install here first"

HASH="$(shasum -a 256 "$SRC" | cut -c1-12)"
GIT_SHA="$(cd "$SRC_DIR" && git rev-parse --short HEAD 2>/dev/null || true)"
GIT_DIRTY=""
if [ -n "$GIT_SHA" ] && ! ( cd "$SRC_DIR" && git diff --quiet HEAD 2>/dev/null ); then
  GIT_DIRTY=" (dirty)"
fi

# Write beside the target and rename, so a send starting mid-install sees
# either the old file or the new one, never a half-written one.
cp "$SRC" "$DEPLOY.tmp"
chmod 755 "$DEPLOY.tmp"
mv -f "$DEPLOY.tmp" "$DEPLOY"

cat > "$VERSION" <<JSON
{
  "hash": "$HASH",
  "deployedAt": "$(date '+%Y-%m-%d %H:%M:%S')",
  "source": "$SRC",
  "git": "${GIT_SHA:-}${GIT_DIRTY}"
}
JSON

# ---------------------------------------------------------------- wrapper
mkdir -p "$HOME/bin"
# Back up ONCE, and only a wrapper this script did not write. Copying on every
# run means the second install overwrites the original with a generated wrapper
# — a backup that cannot restore anything, which is worse than none because it
# looks like one.
if [ -f "$BIN" ] && [ ! -f "$BIN.bak" ] && ! grep -q 'Generated by .*/install' "$BIN"; then
  cp "$BIN" "$BIN.bak"
  say "kept your previous wrapper at $BIN.bak"
fi
cat > "$BIN" <<WRAPPER
#!/usr/bin/env bash
# teams-send — released edition. Generated by $SRC_DIR/install; do not edit.
#
# This runs the DEPLOYED copy, not the working tree. To exercise uncommitted
# changes, run them explicitly from the project directory:
#     node $SRC <args>
set -euo pipefail
export NODE_PATH="$SRC_DIR/node_modules\${NODE_PATH:+:\$NODE_PATH}"
exec node $DEPLOY "\$@"
WRAPPER
chmod 755 "$BIN"

say "deployed $HASH${GIT_SHA:+ (git ${GIT_SHA}${GIT_DIRTY})}"
say "  from  $SRC"
say "  to    $DEPLOY"
say "  via   $BIN"
say "  using playwright $PW"
say "teams-send now runs this edition; editing send.js no longer affects it."
